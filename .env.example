STACK_NAME=cube-console

# 访问端口：18080 是 Cube/OpenAPI，18081 是配置台
GATEWAY_CUBE_PORT=18080
GATEWAY_CONSOLE_PORT=18081
CUBE_PUBLIC_BASE=http://127.0.0.1:18080
CONSOLE_PUBLIC_BASE=http://127.0.0.1:18081

# 版本固定；私有化部署时只需改这里和数据库连接
CUBE_IMAGE=cubejs/cube:v1.7.25
CONSOLE_IMAGE=cube-console:local
GATEWAY_IMAGE=cube-console-gateway:local

# 配置台登录令牌与 Cube API 签名密钥
CUBE_UI_ADMIN_TOKEN=请替换为管理令牌
CUBEJS_API_SECRET=请替换为随机密钥

# 状态目录，相对于 compose.yml
CUBE_DEPLOY_HOST_DIR=./state
# 生产发布脚本会把以下两项更新为不可变 release 目录和持久化 .env 绝对路径。
CUBE_CONSOLE_SOURCE_HOST_DIR=.
CUBE_COMPOSE_ENV_READ_PATH=.env
CUBE_COMPOSE_ENV_HOST_PATH=./.env
# 可选：自定义最终静态 OpenAPI 文件路径；默认 ./state/openapi/openapi.yaml
# CUBE_OPENAPI_PATH=./state/openapi/openapi.yaml

# 可选：原生 MCP 的 Host / Origin 白名单（逗号分隔）。公网部署建议显式填写域名。
# MCP_ALLOWED_HOSTS=cube.example.com,localhost,127.0.0.1
# MCP_ALLOWED_ORIGINS=chatgpt.com,claude.ai

# 首次启动可填写基础数据库信息，之后也可在配置台「数据源」页面修改
CUBEJS_DB_TYPE=mysql
CUBEJS_DB_HOST=
CUBEJS_DB_PORT=3306
CUBEJS_DB_NAME=
CUBEJS_DB_USER=
CUBEJS_DB_PASS=
CUBEJS_DB_SSL=false
CUBEJS_DEV_MODE=false
